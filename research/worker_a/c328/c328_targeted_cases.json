    },
    {
      "id": "c328-http-url-accepted",
      "category": "url",
      "robots": "User-agent: *\nDisallow: /private",
      "agent": "ExampleBot",
      "target": "http://example.test/private",
      "expected": "disallowed"
    },
    {
      "id": "c328-url-with-empty-path-root",
